// Prisma schema — datasource and generator are pre-wired.
// Your DATABASE_URL lives in server/.env (copy it from .env.example).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Category {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  createdAt DateTime @default(now())
  tickets   Ticket[]
}

// Lab2 Issue 2 - Development Requester Context Foundation

model Requester {
  id       Int     @id @default(autoincrement())
  name     String
  email    String  @unique
  isActive Boolean @default(true)
  tickets  Ticket[]
}

model RelatedSystem {
  id   Int    @id @default(autoincrement())
  name String @unique
  tickets  Ticket[]
}

model Ticket {
  id                Int           @id @default(autoincrement())
  ticketNumber      String        @unique
  summary           String
  description       String
  requestedPriority String        // "Low", "Medium", "High"
  currentStatus     String        @default("New")
  createdAt         DateTime      @default(now())

  //(Foreign Keys)
  requesterId       Int
  requester         Requester     @relation(fields: [requesterId], references: [id])
  
  categoryId        Int
  category          Category      @relation(fields: [categoryId], references: [id])
  
  relatedSystemId   Int
  relatedSystem     RelatedSystem @relation(fields: [relatedSystemId], references: [id])
}